# Create an API key with the minimum permissions needed to list Elastic Metal offers.
SCW_SECRET_KEY=replace-with-your-scaleway-secret-key

# Optional overrides
DATABASE_URL=sqlite+aiosqlite:///./data/availability.db
SCW_ZONES=fr-par-1,fr-par-2,nl-ams-1,nl-ams-2,pl-waw-2,pl-waw-3
ENABLE_SCHEDULER=true
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRIES=3
STALE_AFTER_HOURS=2
LOG_LEVEL=INFO

